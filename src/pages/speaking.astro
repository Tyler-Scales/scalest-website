---
import BaseLayout from '../layouts/BaseLayout.astro';
import data from '../../content/pages/speaking.json';
---

<BaseLayout
  title="Speaking"
  description="Tyler S. Wallace, Ph.D. speaks on AI in rural and community health — keynotes, conference sessions, webinars, and workshops for healthcare organizations."
  ogImage="/images/speaking/tyler-wallace-speaking-stage.jpg"
>

  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://scalestreet.com" },
      { "@type": "ListItem", "position": 2, "name": "Speaking", "item": "https://scalestreet.com/speaking" }
    ]
  })} />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="page-hero-inner">
      <div>
        <p class="hero-badge">Speaking</p>
        <h1>{data.heroTitle}<span class="gradient-text">{data.heroTitleGradient}</span></h1>
        <p class="hero-sub">{data.heroSubtitle}</p>
        <a href="mailto:hello@scalestreet.com?subject=Speaking%20request" class="btn btn-primary btn-lg">Invite Tyler to Speak <span class="arrow">&rarr;</span></a>
      </div>
      <div class="hero-image">
        <img src="/images/speaking/tyler-wallace-speaking-stage.jpg" alt="Tyler Wallace on stage delivering a keynote" />
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="section section-alt">
    <div class="section-inner">
      <div class="split-row">
        <div class="split-text">
          <p class="label-tag">What to Expect</p>
          <h2>{data.intro?.title}<span class="gradient-text">{data.intro?.titleGradient}</span></h2>
          {data.intro?.paragraphs?.map((p) => (
            <p class="split-desc">{p}</p>
          ))}
        </div>
        <div class="split-image">
          <img src="/images/speaking/tyler-wallace-speaking-uga.jpg" alt="Tyler Wallace speaking at a podium during a healthcare conference" />
        </div>
      </div>
    </div>
  </section>

  <!-- Engagements -->
  <section class="section">
    <div class="section-inner section-center">
      <p class="label-tag" style="display:table; margin-left:auto; margin-right:auto;">{data.engagementsSubtitle}</p>
      <h2 class="section-title">{data.engagementsTitle}<span class="gradient-text">{data.engagementsTitleGradient}</span></h2>
    </div>
    <div class="section-inner">
      <ul class="engagement-list">
        {data.engagements?.map((e) => (
          <li class="engagement">
            <h3>{e.title}</h3>
            <p>{[e.role, e.event, e.location, e.date].filter(Boolean).join(' · ')}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Photos -->
  <section class="section section-alt">
    <div class="section-inner section-center">
      <p class="label-tag" style="display:table; margin-left:auto; margin-right:auto;">On Stage</p>
      <h2 class="section-title">Speaking <span class="gradient-text">Photos</span></h2>
    </div>
    <div class="section-inner">
      <div class="photo-grid">
        {data.photos?.map((photo) => (
          <img src={photo.src} alt={photo.alt} />
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta-section">
    <div class="section-inner section-center">
      <h2>{data.ctaTitle}</h2>
      <p>{data.ctaSubtitle}</p>
      <div class="cta-actions">
        <a href="mailto:hello@scalestreet.com?subject=Speaking%20request" target="_blank" rel="noopener" class="btn btn-white btn-lg">Invite Tyler to Speak <span class="arrow">&rarr;</span></a>
        <a href="mailto:hello@scalestreet.com" target="_blank" rel="noopener" class="btn btn-outline-white btn-lg">hello@scalestreet.com</a>
      </div>
    </div>
    <div class="cta-deco cta-deco-1"></div>
    <div class="cta-deco cta-deco-2"></div>
  </section>

</BaseLayout>

<style>
  .engagement-list {
    max-width: 820px;
    margin: 0 auto;
    border-top: 1px solid var(--color-gray-200);
  }

  .engagement {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-gray-200);
  }

  .engagement h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-dark);
    line-height: 1.35;
    margin-bottom: 0.25rem;
  }

  .engagement p {
    font-size: 0.8125rem;
    color: var(--color-gray-500);
    line-height: 1.5;
  }

  .photo-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .photo-grid img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 15px;
    box-shadow: 0 10px 40px rgba(11, 34, 57, 0.1);
  }

  @media (max-width: 768px) {
    .photo-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
