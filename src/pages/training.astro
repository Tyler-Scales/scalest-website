---
import BaseLayout from '../layouts/BaseLayout.astro';
import data from '../../content/pages/training.json';
---

<BaseLayout
  title="AI Training for Healthcare"
  description="Healthcare AI training across three tracks: general AI literacy, Microsoft-certified courses, and ambient AI provider training. Webinars, workshops, and coaching."
  ogImage="/images/Tyler%20Training%202.jpg"
>

  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "AI Training for Healthcare",
    "description": "Healthcare AI training across three tracks: general AI literacy, Microsoft-certified courses, and ambient AI provider training.",
    "provider": { "@type": "Organization", "name": "Scale St. Solutions", "url": "https://scalestreet.com" },
    "serviceType": "AI Training",
    "areaServed": { "@type": "Country", "name": "United States" }
  })} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://scalestreet.com" },
      { "@type": "ListItem", "position": 2, "name": "Training", "item": "https://scalestreet.com/training" }
    ]
  })} />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="page-hero-inner">
      <div>
        <p class="hero-badge">Training</p>
        <h1>{data.heroTitle}<span class="gradient-text">{data.heroTitleGradient}</span></h1>
        <p class="hero-sub">{data.heroSubtitle}</p>
        <a href="mailto:hello@scalestreet.com" target="_blank" rel="noopener" class="btn btn-primary btn-lg">Book a Discovery Call <span class="arrow">&rarr;</span></a>
      </div>
      <div class="hero-image">
        <img src="/images/Tyler%20Training%202.jpg" alt="Tyler Wallace delivering AI training" />
      </div>
    </div>
  </section>

  <!-- Programs -->
  <section class="section section-alt">
    <div class="section-inner section-center">
      <p class="label-tag" style="text-align:center;">Three Tracks</p>
      <h2 class="section-title">{data.programs?.title}<span class="gradient-text">{data.programs?.titleGradient}</span></h2>
      <p class="section-subtitle">{data.programs?.subtitle}</p>
    </div>
    <div class="section-inner">
      <div class="program-grid">
        {data.programs?.items?.map((program) => (
          <a href={program.link} class={`program-card ${program.color}`}>
            <span class="program-tag">{program.tag}</span>
            <h3>{program.title}</h3>
            <p>{program.description}</p>
            <span class="program-link">Learn More <span class="arrow">&rarr;</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Training Formats -->
  <section class="section">
    <div class="section-inner section-center">
      <p class="label-tag" style="text-align:center;">How We Train</p>
      <h2 class="section-title">{data.formats?.title}<span class="gradient-text">{data.formats?.titleGradient}</span></h2>
      <p class="section-subtitle">{data.formats?.subtitle}</p>
      <div class="format-grid">
        {data.formats?.items?.map((item) => (
          <div class="format-card">
            <p class="format-num">{item.number}</p>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="section section-alt">
    <div class="section-inner section-center">
      <p class="label-tag" style="text-align:center;">Track Record</p>
      <h2 class="section-title">Proven <span class="gradient-text">Results</span></h2>
    </div>
    <div class="section-inner">
      <div class="card-grid cols-3">
        {data.stats?.map((stat) => (
          <div class="card" style="text-align:center;">
            <span class="card-metric">{stat.value}</span>
            <p>{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonial -->
  <section class="testimonial-section">
    <div class="section-inner">
      <div class="testimonial-card">
        <p class="testimonial-quote">Truly one of the best instructors I have had in a long time. Very knowledgeable and engaging and provided great information and guidance on utilizing generative AI.</p>
        <p class="testimonial-attr">Training Participant</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta-section">
    <div class="section-inner section-center">
      <h2>{data.ctaTitle}</h2>
      <p>{data.ctaSubtitle}</p>
      <div class="cta-actions">
        <a href="mailto:hello@scalestreet.com" target="_blank" rel="noopener" class="btn btn-white btn-lg">Book a Call <span class="arrow">&rarr;</span></a>
        <a href="mailto:hello@scalestreet.com" target="_blank" rel="noopener" class="btn btn-outline-white btn-lg">hello@scalestreet.com</a>
      </div>
    </div>
    <div class="cta-deco cta-deco-1"></div>
    <div class="cta-deco cta-deco-2"></div>
  </section>

</BaseLayout>

<style>
  .program-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .program-card {
    display: flex;
    flex-direction: column;
    background: var(--color-white);
    border: 1px solid var(--color-gray-200);
    border-top: 4px solid var(--color-blue);
    border-radius: 15px;
    padding: 2rem;
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }

  .program-card.mint { border-top-color: var(--color-mint); }
  .program-card.blue { border-top-color: var(--color-blue); }
  .program-card.peach { border-top-color: var(--color-peach); }

  .program-card:hover {
    box-shadow: 0 10px 40px rgba(11, 34, 57, 0.12);
    transform: translateY(-4px);
  }

  .program-tag {
    display: inline-block;
    align-self: flex-start;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-blue);
    background: rgba(15, 15, 189, 0.08);
    padding: 0.25rem 0.7rem;
    border-radius: 100px;
    margin-bottom: 1rem;
  }

  .program-card h3 {
    font-size: 1.125rem;
    font-weight: 900;
    color: var(--color-dark);
    margin-bottom: 0.75rem;
    letter-spacing: -0.01em;
  }

  .program-card p {
    font-size: 0.875rem;
    color: var(--color-gray-500);
    line-height: 1.7;
    margin-bottom: 1.25rem;
    flex: 1;
  }

  .program-link {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-blue);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .format-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .format-card {
    background: var(--color-white);
    border: 1px solid var(--color-gray-200);
    border-radius: 15px;
    padding: 2rem;
    transition: box-shadow 0.3s ease, transform 0.3s ease;
    text-align: left;
  }

  .format-card:hover {
    box-shadow: 0 10px 40px rgba(11, 34, 57, 0.1);
    transform: translateY(-4px);
  }

  .format-num {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-blue);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.75rem;
  }

  .format-card h3 {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-dark);
    margin-bottom: 0.5rem;
  }

  .format-card p {
    font-size: 0.875rem;
    color: var(--color-gray-500);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .program-grid,
    .format-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
