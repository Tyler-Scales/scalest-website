---
import BaseLayout from '../layouts/BaseLayout.astro';
import data from '../../content/pages/strategy.json';

const whoColors = ['var(--color-blue)', 'var(--color-mint)', 'var(--color-green)'];
---

<BaseLayout
  title="AI Strategy for Healthcare"
  description="AI readiness assessments, roadmaps, governance, and vendor selection for healthcare organizations. Strategy grounded in real clinical and operational experience."
  ogImage="/images/conference-room.jpg"
>

  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "AI Strategy for Healthcare",
    "description": "AI readiness assessments, roadmaps, governance, and vendor selection for healthcare organizations.",
    "provider": { "@type": "Organization", "name": "Scale St. Solutions", "url": "https://scalestreet.com" },
    "serviceType": "AI Strategy Consulting",
    "areaServed": { "@type": "Country", "name": "United States" }
  })} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://scalestreet.com" },
      { "@type": "ListItem", "position": 2, "name": "Strategy", "item": "https://scalestreet.com/strategy" }
    ]
  })} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What does an AI readiness assessment for a healthcare organization include?",
        "acceptedAnswer": { "@type": "Answer", "text": "Scale Street's AI readiness assessment reviews your organization's data, infrastructure, workflows, and workforce so you know exactly where you stand before investing in AI tools or programs." }
      },
      {
        "@type": "Question",
        "name": "Can Scale Street help us evaluate AI vendors?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. Scale Street provides independent, healthcare-savvy evaluation of AI vendors and tools — from ambient documentation to Microsoft Copilot — so you buy what will actually get used." }
      },
      {
        "@type": "Question",
        "name": "Does Scale Street help with AI governance and policy?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. We build policies, guardrails, and oversight structures that let healthcare teams use AI confidently while protecting patients, data, and the organization." }
      },
      {
        "@type": "Question",
        "name": "Do you work with organizations that are just starting with AI?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. Whether you're starting the AI conversation or untangling a stalled initiative, strategy engagements are scoped to your organization's stage, budget, and capacity." }
      }
    ]
  })} />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="page-hero-inner">
      <div>
        <p class="hero-badge">Strategy</p>
        <h1>{data.heroTitle}<span class="gradient-text">{data.heroTitleGradient}</span></h1>
        <p class="hero-sub">{data.heroSubtitle}</p>
        <a href="mailto:hello@scalestreet.com" target="_blank" rel="noopener" class="btn btn-primary btn-lg">Book a Discovery Call <span class="arrow">&rarr;</span></a>
      </div>
      <div class="hero-image">
        <img src="/images/conference-room.jpg" alt="Healthcare leadership strategy session" />
      </div>
    </div>
  </section>

  <!-- Strategy Services -->
  <section class="section section-alt">
    <div class="section-inner section-center">
      <p class="label-tag" style="text-align:center;">What We Do</p>
      <h2 class="section-title">{data.services?.title}<span class="gradient-text">{data.services?.titleGradient}</span></h2>
      <p class="section-subtitle">{data.services?.subtitle}</p>
    </div>
    <div class="section-inner">
      <div class="card-grid cols-2">
        {data.services?.items?.map((item) => (
          <div class="card">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Approach -->
  <section class="section">
    <div class="section-inner section-center">
      <p class="label-tag" style="text-align:center;">Our Approach</p>
      <h2 class="section-title">{data.approach?.title}<span class="gradient-text">{data.approach?.titleGradient}</span></h2>
      <p class="section-subtitle">{data.approach?.subtitle}</p>
      <div class="format-grid">
        {data.approach?.items?.map((item) => (
          <div class="format-card">
            <p class="format-num">{item.number}</p>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Who It's For -->
  <section class="section section-alt">
    <div class="section-inner">
      <div class="split-row">
        <div class="split-text">
          <p class="label-tag">Audience</p>
          <h2>{data.whoItsFor?.title}<span class="gradient-text">{data.whoItsFor?.titleGradient}</span></h2>
          <p class="split-desc">{data.whoItsFor?.description}</p>
          <ul class="check-list">
            {data.whoItsFor?.items?.map((item, i) => (
              <li>
                <svg class="check-icon" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="10" fill={whoColors[i] || 'var(--color-blue)'}/><path d="M6 10.5l2.5 2.5 5.5-5.5" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <div>
                  <strong>{item.title}</strong>
                  <span>{item.description}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>
        <div class="split-image">
          <img src="/images/hospital-exterior.jpg" alt="Community hospital" />
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta-section">
    <div class="section-inner section-center">
      <h2>{data.ctaTitle}</h2>
      <p>{data.ctaSubtitle}</p>
      <div class="cta-actions">
        <a href="mailto:hello@scalestreet.com" target="_blank" rel="noopener" class="btn btn-white btn-lg">Book a Call <span class="arrow">&rarr;</span></a>
        <a href="mailto:hello@scalestreet.com" target="_blank" rel="noopener" class="btn btn-outline-white btn-lg">hello@scalestreet.com</a>
      </div>
    </div>
    <div class="cta-deco cta-deco-1"></div>
    <div class="cta-deco cta-deco-2"></div>
  </section>

</BaseLayout>

<style>
  .format-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .format-card {
    background: var(--color-white);
    border: 1px solid var(--color-gray-200);
    border-radius: 15px;
    padding: 2rem;
    transition: box-shadow 0.3s ease, transform 0.3s ease;
    text-align: left;
  }

  .format-card:hover {
    box-shadow: 0 10px 40px rgba(11, 34, 57, 0.1);
    transform: translateY(-4px);
  }

  .format-num {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-blue);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.75rem;
  }

  .format-card h3 {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-dark);
    margin-bottom: 0.5rem;
  }

  .format-card p {
    font-size: 0.875rem;
    color: var(--color-gray-500);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .format-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
