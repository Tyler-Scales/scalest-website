---
import BaseLayout from '../layouts/BaseLayout.astro';
import data from '../../content/pages/government.json';

const stateColors = ['var(--color-blue)', 'var(--color-mint)', 'var(--color-green)'];
---

<BaseLayout
  title="AI for Government"
  description="AI strategy, training, and implementation for state and federal government. Scale Street is a small business with federal contracting experience, serving agencies and public institutions."
  ogImage="/images/UGA-Arches.jpg"
>

  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "AI for Government",
    "description": "AI strategy, training, and implementation for state and federal government agencies and public institutions.",
    "provider": { "@type": "Organization", "name": "Scale St. Solutions", "url": "https://scalestreet.com" },
    "serviceType": "Government AI Enablement",
    "audience": { "@type": "Audience", "audienceType": "State and federal government agencies" }
  })} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://scalestreet.com" },
      { "@type": "ListItem", "position": 2, "name": "Government", "item": "https://scalestreet.com/government" }
    ]
  })} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Is Scale Street a small business for federal contracting purposes?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. Scale Street is a small business with federal contracting experience, and has delivered training and technical work for federal audiences including the FDA and USAID." }
      },
      {
        "@type": "Question",
        "name": "Does Scale Street work with state and local government?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. Scale Street works with state agencies, public universities and technical colleges, and public health organizations — including the University of Georgia and Athens Technical College." }
      },
      {
        "@type": "Question",
        "name": "What AI services does Scale Street offer government agencies?",
        "acceptedAnswer": { "@type": "Answer", "text": "AI literacy training for the government workforce, responsible AI and governance advisory aligned with federal guidance, and Microsoft-certified Copilot training adapted to government M365 environments." }
      }
    ]
  })} />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="page-hero-inner">
      <div>
        <p class="hero-badge">Focus Area</p>
        <h1>{data.heroTitle}<span class="gradient-text">{data.heroTitleGradient}</span></h1>
        <p class="hero-sub">{data.heroSubtitle}</p>
        <a href="mailto:hello@scalestreet.com" target="_blank" rel="noopener" class="btn btn-primary btn-lg">Book a Discovery Call <span class="arrow">&rarr;</span></a>
      </div>
      <div class="hero-image">
        <img src="/images/UGA-Arches.jpg" alt="The Arch at the University of Georgia" />
      </div>
    </div>
  </section>

  <!-- Federal -->
  <section class="section section-alt">
    <div class="section-inner section-center">
      <p class="label-tag" style="text-align:center;">Federal</p>
      <h2 class="section-title">{data.federal?.title}<span class="gradient-text">{data.federal?.titleGradient}</span></h2>
      <p class="section-subtitle">{data.federal?.description}</p>
    </div>
    <div class="section-inner">
      <div class="card-grid cols-3">
        {data.federal?.items?.map((item) => (
          <div class="card">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- State & Local -->
  <section class="section">
    <div class="section-inner">
      <div class="split-row">
        <div class="split-text">
          <p class="label-tag">State &amp; Local</p>
          <h2>{data.state?.title}<span class="gradient-text">{data.state?.titleGradient}</span></h2>
          <p class="split-desc">{data.state?.description}</p>
          <ul class="check-list">
            {data.state?.items?.map((item, i) => (
              <li>
                <svg class="check-icon" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="10" fill={stateColors[i] || 'var(--color-blue)'}/><path d="M6 10.5l2.5 2.5 5.5-5.5" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <div>
                  <strong>{item.title}</strong>
                  <span>{item.description}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>
        <div class="split-image">
          <img src="/images/conference-room.jpg" alt="Government team training session" />
        </div>
      </div>
    </div>
  </section>

  <!-- Small Business -->
  <section class="section section-alt">
    <div class="section-inner">
      <div class="split-row reverse">
        <div class="split-image">
          <img src="/images/Tyler%20Training%201.jpg" alt="Tyler Wallace leading a training session" />
        </div>
        <div class="split-text">
          <p class="label-tag">Why Scale Street</p>
          <h2>{data.smallBusiness?.title}<span class="gradient-text">{data.smallBusiness?.titleGradient}</span></h2>
          <p class="split-desc">{data.smallBusiness?.description}</p>
          <ul class="check-list">
            {data.smallBusiness?.highlights?.map((highlight, i) => (
              <li>
                <svg class="check-icon" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="10" fill={i % 2 === 0 ? 'var(--color-blue)' : 'var(--color-mint)'}/><path d="M6 10.5l2.5 2.5 5.5-5.5" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <div>
                  <strong>{highlight}</strong>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Government Logos -->
  <section class="section-sm">
    <div class="section-inner section-center">
      <p class="partners-label">Government & Public Institutions We've Worked With</p>
      <div class="logo-grid">
        <img src="/images/logos/fda.png" alt="FDA" />
        <img src="/images/logos/usaid.jpg" alt="USAID" />
        <img src="/images/logos/uga.png" alt="University of Georgia" />
        <img src="/images/logos/athens-tech.png" alt="Athens Technical College" />
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta-section">
    <div class="section-inner section-center">
      <h2>{data.ctaTitle}</h2>
      <p>{data.ctaSubtitle}</p>
      <div class="cta-actions">
        <a href="mailto:hello@scalestreet.com" target="_blank" rel="noopener" class="btn btn-white btn-lg">Book a Call <span class="arrow">&rarr;</span></a>
        <a href="mailto:hello@scalestreet.com" target="_blank" rel="noopener" class="btn btn-outline-white btn-lg">hello@scalestreet.com</a>
      </div>
    </div>
    <div class="cta-deco cta-deco-1"></div>
    <div class="cta-deco cta-deco-2"></div>
  </section>

</BaseLayout>

<style>
  .logo-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem 3rem;
    align-items: center;
    justify-items: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .logo-grid img {
    max-height: 70px;
    max-width: 180px;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  @media (max-width: 768px) {
    .logo-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem 2rem;
    }
  }
</style>
