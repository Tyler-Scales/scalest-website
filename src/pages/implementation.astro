---
import BaseLayout from '../layouts/BaseLayout.astro';
import data from '../../content/pages/implementation.json';
---

<BaseLayout
  title="AI Implementation for Healthcare"
  description="Hands-on AI deployment for healthcare — ambient documentation (Nuance DAX, Sunoh.ai), Microsoft Copilot rollout, workflow integration, and go-live support."
>

  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "AI Implementation for Healthcare",
    "description": "Hands-on AI deployment for healthcare — ambient documentation, Microsoft Copilot rollout, workflow integration, and go-live support.",
    "provider": { "@type": "Organization", "name": "Scale St. Solutions", "url": "https://scalestreet.com" },
    "serviceType": "AI Implementation",
    "areaServed": { "@type": "Country", "name": "United States" }
  })} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://scalestreet.com" },
      { "@type": "ListItem", "position": 2, "name": "Implementation", "item": "https://scalestreet.com/implementation" }
    ]
  })} />

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="page-hero-inner">
      <div>
        <p class="hero-badge">Implementation</p>
        <h1>{data.heroTitle}<span class="gradient-text">{data.heroTitleGradient}</span></h1>
        <p class="hero-sub">{data.heroSubtitle}</p>
        <a href="mailto:hello@scalestreet.com" target="_blank" rel="noopener" class="btn btn-primary btn-lg">Book a Discovery Call <span class="arrow">&rarr;</span></a>
      </div>
      <div class="hero-image">
        <img src="/images/ambient.jpg" alt="Ambient AI documentation in a clinical setting" />
      </div>
    </div>
  </section>

  <!-- What We Implement -->
  <section class="section section-alt">
    <div class="section-inner section-center">
      <p class="label-tag" style="text-align:center;">What We Do</p>
      <h2 class="section-title">{data.services?.title}<span class="gradient-text">{data.services?.titleGradient}</span></h2>
      <p class="section-subtitle">{data.services?.subtitle}</p>
    </div>
    <div class="section-inner">
      <div class="card-grid cols-2">
        {data.services?.items?.map((item) => (
          <div class="card">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How We Deploy -->
  <section class="section">
    <div class="section-inner section-center">
      <p class="label-tag" style="text-align:center;">Our Playbook</p>
      <h2 class="section-title">{data.approach?.title}<span class="gradient-text">{data.approach?.titleGradient}</span></h2>
      <p class="section-subtitle">{data.approach?.subtitle}</p>
      <div class="format-grid">
        {data.approach?.items?.map((item) => (
          <div class="format-card">
            <p class="format-num">{item.number}</p>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="section section-alt">
    <div class="section-inner section-center">
      <p class="label-tag" style="text-align:center;">Track Record</p>
      <h2 class="section-title">Proven <span class="gradient-text">Results</span></h2>
    </div>
    <div class="section-inner">
      <div class="card-grid cols-2">
        {data.stats?.map((stat) => (
          <div class="card" style="text-align:center;">
            <span class="card-metric">{stat.value}</span>
            <p>{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta-section">
    <div class="section-inner section-center">
      <h2>{data.ctaTitle}</h2>
      <p>{data.ctaSubtitle}</p>
      <div class="cta-actions">
        <a href="mailto:hello@scalestreet.com" target="_blank" rel="noopener" class="btn btn-white btn-lg">Book a Call <span class="arrow">&rarr;</span></a>
        <a href="mailto:hello@scalestreet.com" target="_blank" rel="noopener" class="btn btn-outline-white btn-lg">hello@scalestreet.com</a>
      </div>
    </div>
    <div class="cta-deco cta-deco-1"></div>
    <div class="cta-deco cta-deco-2"></div>
  </section>

</BaseLayout>

<style>
  .format-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .format-card {
    background: var(--color-white);
    border: 1px solid var(--color-gray-200);
    border-radius: 15px;
    padding: 2rem;
    transition: box-shadow 0.3s ease, transform 0.3s ease;
    text-align: left;
  }

  .format-card:hover {
    box-shadow: 0 10px 40px rgba(11, 34, 57, 0.1);
    transform: translateY(-4px);
  }

  .format-num {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-blue);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.75rem;
  }

  .format-card h3 {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-dark);
    margin-bottom: 0.5rem;
  }

  .format-card p {
    font-size: 0.875rem;
    color: var(--color-gray-500);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .format-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
